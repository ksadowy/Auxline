<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Auxline.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Release builds get the version from the git tag (tools/build-release.ps1); local builds stay 0.0.0. -->
    <VersionPrefix>0.0.0</VersionPrefix>
    <Product>Auxline</Product>
    <Authors>Krzysztof Sadowy</Authors>
    <Copyright>Copyright © Krzysztof Sadowy</Copyright>
    <Description>Media widget for the Windows 11 taskbar</Description>
    <!-- The UI is English only: leave out the framework's translated resources (smaller install). -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- The flyout style render test uses the (internal) palette. -->
    <InternalsVisibleTo Include="Auxline.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pixel themes' fonts (SIL Open Font License, see the *-OFL.txt next to them). -->
    <Resource Include="Fonts\*.ttf" />
    <!-- Tray icons (tools/build-icons.ps1); the app icon is embedded via ApplicationIcon. -->
    <Resource Include="Assets\Tray*.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

</Project>
