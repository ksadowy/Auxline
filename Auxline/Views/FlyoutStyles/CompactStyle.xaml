<UserControl x:Class="Auxline.Views.FlyoutStyles.CompactStyle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Auxline.ViewModels"
             xmlns:controls="clr-namespace:Auxline.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PlayerViewModel}"
             Width="320">
    <UserControl.Resources>
        <ResourceDictionary Source="FlyoutResources.xaml" />
    </UserControl.Resources>

    <!-- One row; the volume button expands a slider below; progress line along the bottom edge. -->
    <StackPanel>
        <Grid Margin="10,10,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:CoverArt Width="52" Height="52" CornerRadius="6" Source="{Binding Cover}" />
            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Trimmed}" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Trimmed}" FontSize="12" Foreground="{DynamicResource FlyoutSecondaryTextBrush}">
                    <Run Text="{Binding Artist, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding PositionText, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding DurationText, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource PrimaryButton}" Width="40" Height="40" FontSize="16"
                        Command="{Binding TogglePlayPauseCommand}" ToolTip="Play / Pause">
                    <controls:ThemedIcon Style="{StaticResource PlayPauseIcon}" />
                </Button>
                <Button Style="{StaticResource IconButton}" Margin="4,0,0,0" Width="40" Height="40"
                        Command="{Binding SkipNextCommand}" ToolTip="Next">
                    <controls:ThemedIcon Kind="Next" />
                </Button>
                <ToggleButton x:Name="VolumeToggle" Style="{StaticResource IconButton}" Width="40" Height="40"
                              ToolTip="Volume" Foreground="{DynamicResource FlyoutSecondaryTextBrush}">
                    <controls:ThemedIcon Kind="Volume" />
                </ToggleButton>
            </StackPanel>
        </Grid>

        <DockPanel Margin="12,0,12,8"
                   Visibility="{Binding IsChecked, ElementName=VolumeToggle, Converter={StaticResource BoolToVisibility}}">
            <TextBlock DockPanel.Dock="Right" Width="36" TextAlignment="Right" VerticalAlignment="Center" FontSize="12"
                       Text="{Binding VolumePercent, StringFormat={}{0:0}%}" Foreground="{DynamicResource FlyoutSecondaryTextBrush}" />
            <Slider Style="{StaticResource FlyoutSlider}" Minimum="0" Maximum="100"
                    Value="{Binding VolumePercent}" IsEnabled="{Binding HasAudioSession}" />
        </DockPanel>

        <Slider x:Name="ProgressSlider" Style="{StaticResource FlyoutSliderThin}" Margin="0,-4,0,0"
                Visibility="{Binding HasTimeline, Converter={StaticResource BoolToVisibility}}"
                Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds}" IsEnabled="{Binding CanSeek}" />
    </StackPanel>
</UserControl>
