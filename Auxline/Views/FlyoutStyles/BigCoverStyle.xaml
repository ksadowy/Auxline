<UserControl x:Class="Auxline.Views.FlyoutStyles.BigCoverStyle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Auxline.ViewModels"
             xmlns:controls="clr-namespace:Auxline.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PlayerViewModel}"
             Width="320">
    <UserControl.Resources>
        <ResourceDictionary Source="FlyoutResources.xaml" />
    </UserControl.Resources>

    <!-- Full-width cover, centred title, big play button. -->
    <StackPanel Margin="16">
        <controls:CoverArt Width="288" Height="288" CornerRadius="8" Source="{Binding Cover}" />

        <TextBlock Style="{StaticResource Trimmed}" Margin="0,14,0,0" HorizontalAlignment="Center"
                   Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource Trimmed}" Margin="0,2,0,0" HorizontalAlignment="Center" FontSize="13"
                   Foreground="{DynamicResource FlyoutSecondaryTextBrush}">
            <Run Text="{Binding Artist, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Album, Mode=OneWay}" />
        </TextBlock>

        <StackPanel Margin="0,12,0,0" Visibility="{Binding HasTimeline, Converter={StaticResource BoolToVisibility}}">
            <Slider x:Name="ProgressSlider" Style="{StaticResource FlyoutSliderThin}" Tag="4"
                    Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds}" IsEnabled="{Binding CanSeek}" />
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding DurationText}" FontSize="11"
                           Foreground="{DynamicResource FlyoutSecondaryTextBrush}" />
                <TextBlock Text="{Binding PositionText}" FontSize="11" Foreground="{DynamicResource FlyoutSecondaryTextBrush}" />
            </DockPanel>
        </StackPanel>

        <StackPanel Margin="0,8,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Style="{StaticResource IconButton}" Command="{Binding SkipPreviousCommand}" ToolTip="Previous"
                    FontSize="20">
                <controls:ThemedIcon Kind="Previous" />
            </Button>
            <Button Style="{StaticResource PrimaryButton}" Margin="24,0" Width="56" Height="56" FontSize="22"
                    Command="{Binding TogglePlayPauseCommand}" ToolTip="Play / Pause">
                <controls:ThemedIcon Style="{StaticResource PlayPauseIcon}" />
            </Button>
            <Button Style="{StaticResource IconButton}" Command="{Binding SkipNextCommand}" ToolTip="Next"
                    FontSize="20">
                <controls:ThemedIcon Kind="Next" />
            </Button>
        </StackPanel>

        <DockPanel Margin="0,10,0,0">
            <controls:ThemedIcon Kind="VolumeLow" DockPanel.Dock="Left" Margin="0,0,10,0" VerticalAlignment="Center"
                                 Foreground="{DynamicResource FlyoutSecondaryTextBrush}" />
            <controls:ThemedIcon Kind="VolumeHigh" DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Center"
                                 Foreground="{DynamicResource FlyoutSecondaryTextBrush}" />
            <Slider Style="{StaticResource FlyoutSliderThin}" Tag="4" Foreground="{DynamicResource FlyoutSecondaryTextBrush}"
                    Minimum="0" Maximum="100" Value="{Binding VolumePercent}" IsEnabled="{Binding HasAudioSession}"
                    ToolTip="{Binding VolumePercent, StringFormat=Volume {0:0}%}" />
        </DockPanel>
    </StackPanel>
</UserControl>
