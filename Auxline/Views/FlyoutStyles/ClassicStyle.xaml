<UserControl x:Class="Auxline.Views.FlyoutStyles.ClassicStyle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Auxline.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PlayerViewModel}"
             Width="320">
    <UserControl.Resources>
        <ResourceDictionary Source="FlyoutResources.xaml" />
    </UserControl.Resources>

    <!-- Cover left with three text lines, progress, controls, volume. -->
    <StackPanel Margin="16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Width="72" Height="72" CornerRadius="6">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                </Border.Background>
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Trimmed}" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Trimmed}" Text="{Binding Artist}" FontSize="12"
                           Foreground="{DynamicResource FlyoutSecondaryTextBrush}" />
                <TextBlock Style="{StaticResource Trimmed}" Text="{Binding Album}" FontSize="12"
                           Foreground="{DynamicResource FlyoutTertiaryTextBrush}" />
            </StackPanel>
        </Grid>

        <Grid Margin="0,12,0,0" Visibility="{Binding HasTimeline, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding PositionText}" FontSize="11" VerticalAlignment="Center"
                       Foreground="{DynamicResource FlyoutSecondaryTextBrush}" />
            <Slider x:Name="ProgressSlider" Grid.Column="1" Margin="8,0" Style="{StaticResource FlyoutSlider}"
                    Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds}" IsEnabled="{Binding CanSeek}" />
            <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="11" VerticalAlignment="Center"
                       Foreground="{DynamicResource FlyoutSecondaryTextBrush}" />
        </Grid>

        <StackPanel Margin="0,8,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Style="{StaticResource IconButton}" Command="{Binding SkipPreviousCommand}" ToolTip="Previous" Content="&#xE892;" />
            <Button Style="{StaticResource IconButton}" Margin="8,0" Command="{Binding TogglePlayPauseCommand}" ToolTip="Play / Pause">
                <TextBlock Style="{StaticResource PlayPauseGlyph}" />
            </Button>
            <Button Style="{StaticResource IconButton}" Command="{Binding SkipNextCommand}" ToolTip="Next" Content="&#xE893;" />
        </StackPanel>

        <DockPanel Margin="0,8,0,0">
            <TextBlock DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center"
                       FontFamily="{StaticResource IconFont}" Text="&#xE767;" />
            <TextBlock DockPanel.Dock="Right" Width="36" TextAlignment="Right" VerticalAlignment="Center"
                       Text="{Binding VolumePercent, StringFormat={}{0:0}%}" />
            <Slider Style="{StaticResource FlyoutSlider}" Minimum="0" Maximum="100"
                    Value="{Binding VolumePercent}" IsEnabled="{Binding HasAudioSession}" />
        </DockPanel>
    </StackPanel>
</UserControl>
