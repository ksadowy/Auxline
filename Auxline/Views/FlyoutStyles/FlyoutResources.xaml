<!--
    Building blocks shared by all flyout styles (each style merges this file). Colours and control templates are
    DynamicResource keys (FlyoutSecondaryTextBrush, IconButtonTemplate, …) that the current theme provides
    (Views/Themes, merged into the flyout window by FlyoutWindow). They're deliberately NOT defined here: a style
    would find them in its own merged copy first and never see the theme's values.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Auxline.Controls">

    <!-- Icon button (transparent until hovered in the default theme). ButtonBase, so toggle buttons can use it too. -->
    <Style x:Key="IconButton" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template" Value="{DynamicResource IconButtonTemplate}" />
        <!-- Optional theme key, for buttons with their own face colour (see ThemedIcon.IconBrush). -->
        <Setter Property="controls:ThemedIcon.IconBrush" Value="{DynamicResource IconButtonIconBrush}" />
    </Style>

    <!-- Emphasised button (play/pause). Size per style via Width/Height; colours via Background/Foreground. -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource FlyoutPrimaryButtonBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource FlyoutPrimaryButtonForegroundBrush}" />
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template" Value="{DynamicResource PrimaryButtonTemplate}" />
        <Setter Property="controls:ThemedIcon.IconBrush" Value="{DynamicResource PrimaryButtonIconBrush}" />
    </Style>

    <!-- Play while paused, pause while playing. -->
    <Style x:Key="PlayPauseIcon" TargetType="controls:ThemedIcon">
        <Setter Property="Kind" Value="Play" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                <Setter Property="Kind" Value="Pause" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        Seek/volume bar. Tag = track thickness in px (themes may ignore it); Foreground = fill colour.
        Clicking anywhere jumps there (IsMoveToPointEnabled); FlyoutWindow recognises the seek bar by x:Name="ProgressSlider".
    -->
    <Style x:Key="FlyoutSlider" TargetType="Slider">
        <Setter Property="Tag" Value="4" />
        <Setter Property="Foreground" Value="{DynamicResource FlyoutSliderFillBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template" Value="{DynamicResource FlyoutSliderTemplate}" />
    </Style>

    <!-- Slimmer variant without a visible thumb (still clickable/draggable). -->
    <Style x:Key="FlyoutSliderThin" TargetType="Slider" BasedOn="{StaticResource FlyoutSlider}">
        <Setter Property="Tag" Value="3" />
        <Setter Property="Template" Value="{DynamicResource FlyoutSliderThinTemplate}" />
    </Style>

    <Style x:Key="Trimmed" TargetType="TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
</ResourceDictionary>
