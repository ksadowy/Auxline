<UserControl x:Class="Auxline.Views.FlyoutStyles.CoverTintedStyle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Auxline.ViewModels"
             xmlns:controls="clr-namespace:Auxline.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PlayerViewModel}"
             Width="320">
    <UserControl.Resources>
        <ResourceDictionary Source="FlyoutResources.xaml" />
    </UserControl.Resources>

    <!-- Background and accent from the album art (CoverTint/CoverAccent brushes, set by FlyoutWindow). -->
    <Border Background="{DynamicResource CoverTintBrush}" Padding="16">
        <StackPanel TextElement.Foreground="{DynamicResource CoverTextBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:CoverArt Width="96" Height="96" CornerRadius="8" Source="{Binding Cover}" />
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="NOW PLAYING" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource CoverAccentBrush}" />
                    <TextBlock Style="{StaticResource Trimmed}" Margin="0,3,0,0" Text="{Binding Title}" FontSize="17" FontWeight="Bold" />
                    <TextBlock Style="{StaticResource Trimmed}" Text="{Binding Artist}" FontSize="13"
                               Foreground="{DynamicResource CoverSecondaryTextBrush}" />
                    <TextBlock Style="{StaticResource Trimmed}" Text="{Binding Album}" FontSize="12"
                               Foreground="{DynamicResource CoverSecondaryTextBrush}" Opacity="0.85" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,14,0,0" Visibility="{Binding HasTimeline, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding PositionText}" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource CoverSecondaryTextBrush}" />
                <Slider x:Name="ProgressSlider" Grid.Column="1" Margin="8,0" Style="{StaticResource FlyoutSliderThin}" Tag="4"
                        Foreground="{DynamicResource CoverAccentBrush}"
                        Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds}" IsEnabled="{Binding CanSeek}" />
                <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource CoverSecondaryTextBrush}" />
            </Grid>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <controls:ThemedIcon Kind="Volume" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Foreground="{DynamicResource CoverSecondaryTextBrush}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Foreground="{DynamicResource CoverTextBrush}"
                            Command="{Binding SkipPreviousCommand}" ToolTip="Previous" FontSize="18">
                        <controls:ThemedIcon Kind="Previous" />
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Margin="12,0" Width="52" Height="52" FontSize="20"
                            Background="{DynamicResource CoverAccentBrush}" Foreground="{DynamicResource CoverAccentForegroundBrush}"
                            Command="{Binding TogglePlayPauseCommand}" ToolTip="Play / Pause">
                        <controls:ThemedIcon Style="{StaticResource PlayPauseIcon}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Foreground="{DynamicResource CoverTextBrush}"
                            Command="{Binding SkipNextCommand}" ToolTip="Next" FontSize="18">
                        <controls:ThemedIcon Kind="Next" />
                    </Button>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding VolumePercent, StringFormat={}{0:0}%}" FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource CoverSecondaryTextBrush}" />
            </Grid>

            <Slider Margin="0,6,0,0" Style="{StaticResource FlyoutSliderThin}" Tag="4"
                    Foreground="{DynamicResource CoverSecondaryTextBrush}"
                    Minimum="0" Maximum="100" Value="{Binding VolumePercent}" IsEnabled="{Binding HasAudioSession}" />
        </StackPanel>
    </Border>
</UserControl>
