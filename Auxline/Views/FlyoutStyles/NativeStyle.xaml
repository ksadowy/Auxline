<UserControl x:Class="Auxline.Views.FlyoutStyles.NativeStyle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Auxline.ViewModels"
             xmlns:controls="clr-namespace:Auxline.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PlayerViewModel}"
             Width="320">
    <UserControl.Resources>
        <ResourceDictionary Source="FlyoutResources.xaml" />
    </UserControl.Resources>

    <!-- Like Windows' own media flyout: app name, title left / cover right, accent-coloured play button. -->
    <StackPanel Margin="16,12,16,12">
        <StackPanel Orientation="Horizontal">
            <controls:ThemedIcon Kind="Music" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource FlyoutAccentBrush}" />
            <TextBlock Margin="8,0,0,0" Text="{Binding SourceName}" FontSize="12" VerticalAlignment="Center"
                       Foreground="{DynamicResource FlyoutSecondaryTextBrush}" />
        </StackPanel>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Style="{StaticResource Trimmed}" Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Trimmed}" Margin="0,2,0,0" Text="{Binding Artist}" FontSize="13"
                           Foreground="{DynamicResource FlyoutSecondaryTextBrush}" />
            </StackPanel>
            <controls:CoverArt Grid.Column="1" Width="80" Height="80" CornerRadius="4" Source="{Binding Cover}" />
        </Grid>

        <StackPanel Margin="0,12,0,0" Visibility="{Binding HasTimeline, Converter={StaticResource BoolToVisibility}}">
            <Slider x:Name="ProgressSlider" Style="{StaticResource FlyoutSliderThin}" Foreground="{DynamicResource FlyoutAccentBrush}"
                    Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds}" IsEnabled="{Binding CanSeek}" />
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding DurationText}" FontSize="11"
                           Foreground="{DynamicResource FlyoutSecondaryTextBrush}" />
                <TextBlock Text="{Binding PositionText}" FontSize="11" Foreground="{DynamicResource FlyoutSecondaryTextBrush}" />
            </DockPanel>
        </StackPanel>

        <StackPanel Margin="0,8,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Style="{StaticResource IconButton}" Command="{Binding SkipPreviousCommand}" ToolTip="Previous"
                    FontSize="18">
                <controls:ThemedIcon Kind="Previous" />
            </Button>
            <Button Style="{StaticResource PrimaryButton}" Margin="16,0" Width="44" Height="44"
                    Background="{DynamicResource FlyoutAccentBrush}" Foreground="{DynamicResource FlyoutAccentForegroundBrush}"
                    Command="{Binding TogglePlayPauseCommand}" ToolTip="Play / Pause">
                <controls:ThemedIcon Style="{StaticResource PlayPauseIcon}" />
            </Button>
            <Button Style="{StaticResource IconButton}" Command="{Binding SkipNextCommand}" ToolTip="Next"
                    FontSize="18">
                <controls:ThemedIcon Kind="Next" />
            </Button>
        </StackPanel>

        <Border Margin="0,8,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource FlyoutSeparatorBrush}" Padding="0,8,0,0">
            <DockPanel>
                <controls:ThemedIcon Kind="Volume" DockPanel.Dock="Left" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Width="32" TextAlignment="Right" VerticalAlignment="Center"
                           Text="{Binding VolumePercent, StringFormat={}{0:0}}" Foreground="{DynamicResource FlyoutSecondaryTextBrush}" />
                <Slider Style="{StaticResource FlyoutSlider}" Foreground="{DynamicResource FlyoutAccentBrush}"
                        Minimum="0" Maximum="100" Value="{Binding VolumePercent}" IsEnabled="{Binding HasAudioSession}" />
            </DockPanel>
        </Border>
    </StackPanel>
</UserControl>
