<!-- Pieces the themes' slider templates share; merged into each theme. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Played part of a line slider: Tag = thickness, Foreground = colour (both from the Slider). -->
    <Style x:Key="SliderFilledPart" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="{Binding Tag, RelativeSource={RelativeSource AncestorType=Slider}}"
                                CornerRadius="2" VerticalAlignment="Center"
                                Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Clickable but invisible: the rest of the line, or both parts when the bar is drawn by a RangeBar. -->
    <Style x:Key="SliderEmptyPart" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="InvisibleThumb" TargetType="Thumb">
        <Rectangle Width="10" Fill="Transparent" />
    </ControlTemplate>
</ResourceDictionary>
