<!--
    Vinyl flyout theme: warm walnut hi-fi with cream text and an amber accent, Bahnschrift (FlyoutThemes). The cover
    is the label of a record that spins while playing; buttons are brushed aluminium keys, play has an amber light.
    Builds on the default theme (icons, thin slider) and replaces the rest.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Auxline.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="DefaultTheme.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Color x:Key="VinylCreamColor">#F1E4C8</Color>
    <Color x:Key="VinylSandColor">#CDBB98</Color>
    <Color x:Key="VinylAmberColor">#E8A33D</Color>
    <Color x:Key="VinylWoodColor">#24170F</Color>
    <Color x:Key="VinylInkColor">#1B110B</Color>

    <SolidColorBrush x:Key="VinylAmber" Color="{StaticResource VinylAmberColor}" />
    <SolidColorBrush x:Key="VinylInk" Color="{StaticResource VinylInkColor}" />
    <SolidColorBrush x:Key="VinylKeyEdge" Color="#0D0906" />
    <!-- Dark icons on the aluminium keys (see ThemedIcon.IconBrush). -->
    <SolidColorBrush x:Key="IconButtonIconBrush" Color="#2B2420" />
    <SolidColorBrush x:Key="PrimaryButtonIconBrush" Color="#2B2420" />

    <!-- The keys every theme defines (see FlyoutPalette for what they're used for). -->
    <SolidColorBrush x:Key="FlyoutForegroundBrush" Color="{StaticResource VinylCreamColor}" />
    <SolidColorBrush x:Key="FlyoutBackgroundBrush" Color="{StaticResource VinylWoodColor}" />
    <SolidColorBrush x:Key="FlyoutSecondaryTextBrush" Color="{StaticResource VinylSandColor}" />
    <SolidColorBrush x:Key="FlyoutTertiaryTextBrush" Color="#8F7B5C" />
    <SolidColorBrush x:Key="FlyoutTrackBrush" Color="#4A3628" />
    <SolidColorBrush x:Key="FlyoutSliderFillBrush" Color="{StaticResource VinylAmberColor}" />
    <SolidColorBrush x:Key="FlyoutHoverBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="FlyoutPressedBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="FlyoutSeparatorBrush" Color="#4A3221" />
    <SolidColorBrush x:Key="FlyoutPrimaryButtonBrush" Color="{StaticResource VinylAmberColor}" />
    <SolidColorBrush x:Key="FlyoutPrimaryButtonForegroundBrush" Color="{StaticResource VinylInkColor}" />
    <SolidColorBrush x:Key="FlyoutAccentBrush" Color="{StaticResource VinylAmberColor}" />
    <SolidColorBrush x:Key="FlyoutAccentForegroundBrush" Color="{StaticResource VinylInkColor}" />
    <SolidColorBrush x:Key="CoverTintBrush" Color="#2B1D14" />
    <SolidColorBrush x:Key="CoverAccentBrush" Color="{StaticResource VinylAmberColor}" />
    <SolidColorBrush x:Key="CoverAccentForegroundBrush" Color="{StaticResource VinylInkColor}" />
    <SolidColorBrush x:Key="CoverTextBrush" Color="{StaticResource VinylCreamColor}" />
    <SolidColorBrush x:Key="CoverSecondaryTextBrush" Color="{StaticResource VinylSandColor}" />

    <LinearGradientBrush x:Key="VinylWalnut" StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#3A2618" Offset="0" />
        <GradientStop Color="{StaticResource VinylWoodColor}" Offset="0.6" />
        <GradientStop Color="{StaticResource VinylInkColor}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="VinylAluminium" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E4DFD2" Offset="0" />
        <GradientStop Color="#B0AA9C" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="VinylAluminiumHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F0ECE2" Offset="0" />
        <GradientStop Color="#C2BCAE" Offset="1" />
    </LinearGradientBrush>

    <!-- A key held down: darker, light from below. -->
    <LinearGradientBrush x:Key="VinylAluminiumPressed" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#A9A395" Offset="0" />
        <GradientStop Color="#CFC9BB" Offset="1" />
    </LinearGradientBrush>

    <!-- Grooves: rings repeating every 3 % of the radius. -->
    <RadialGradientBrush x:Key="VinylGrooves" RadiusX="0.03" RadiusY="0.03" SpreadMethod="Repeat">
        <GradientStop Color="#111111" Offset="0" />
        <GradientStop Color="#1F1F1F" Offset="0.5" />
        <GradientStop Color="#111111" Offset="1" />
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="VinylSheen" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="Transparent" Offset="0.2" />
        <GradientStop Color="#1FFFFFFF" Offset="0.35" />
        <GradientStop Color="Transparent" Offset="0.5" />
        <GradientStop Color="#14FFFFFF" Offset="0.7" />
        <GradientStop Color="Transparent" Offset="0.85" />
    </LinearGradientBrush>

    <ControlTemplate x:Key="FlyoutFrameTemplate" TargetType="ContentControl">
        <Border Background="{StaticResource VinylWalnut}">
            <ContentPresenter />
        </Border>
    </ControlTemplate>

    <!-- The cover as the label of a record (any size); it spins while playing. -->
    <ControlTemplate x:Key="CoverArtTemplate" TargetType="controls:CoverArt">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="4*" />
                <RowDefinition Height="3*" />
            </Grid.RowDefinitions>
            <Ellipse Grid.ColumnSpan="3" Grid.RowSpan="3" Fill="{StaticResource VinylGrooves}" />
            <Ellipse x:Name="Label" Grid.Column="1" Grid.Row="1" RenderTransformOrigin="0.5,0.5">
                <Ellipse.Fill>
                    <ImageBrush ImageSource="{Binding Source, RelativeSource={RelativeSource TemplatedParent}}" Stretch="UniformToFill" />
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <RotateTransform />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Grid.Column="1" Grid.Row="1" Width="4" Height="4" Fill="#D9D4C7" />
            <Ellipse Grid.ColumnSpan="3" Grid.RowSpan="3" Fill="{StaticResource VinylSheen}" IsHitTestVisible="False" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="controls:ThemeAnimation.IsActive" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="Spin">
                        <Storyboard Timeline.DesiredFrameRate="30">
                            <DoubleAnimation Storyboard.TargetName="Label" Storyboard.TargetProperty="RenderTransform.Angle"
                                             From="0" To="360" Duration="0:0:4" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="Spin" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Brushed aluminium key on a dark edge; pressing pushes it down. -->
    <ControlTemplate x:Key="IconButtonTemplate" TargetType="ButtonBase">
        <Grid>
            <Border Margin="0,2,0,0" CornerRadius="4" Background="{StaticResource VinylKeyEdge}" />
            <Border x:Name="Key" Margin="0,0,0,2" CornerRadius="4" BorderThickness="1"
                    BorderBrush="{StaticResource VinylKeyEdge}" Background="{StaticResource VinylAluminium}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Key" Property="Background" Value="{StaticResource VinylAluminiumHover}" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
                <Setter TargetName="Key" Property="Margin" Value="0,2,0,0" />
                <Setter TargetName="Key" Property="Background" Value="{StaticResource VinylAluminiumPressed}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Key" Property="Margin" Value="0,2,0,0" />
                <Setter TargetName="Key" Property="Background" Value="{StaticResource VinylAluminiumPressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Play: a key with an amber light that glows while playing. -->
    <ControlTemplate x:Key="PrimaryButtonTemplate" TargetType="Button">
        <Grid>
            <Border Margin="0,2,0,0" CornerRadius="4" Background="{StaticResource VinylKeyEdge}" />
            <Border x:Name="Key" Margin="0,0,0,2" CornerRadius="4" BorderThickness="1"
                    BorderBrush="{StaticResource VinylKeyEdge}" Background="{StaticResource VinylAluminium}">
                <Grid>
                    <Ellipse x:Name="Light" Width="5" Height="5" Margin="0,5,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                             Fill="#5C4520" />
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                <Setter TargetName="Light" Property="Fill" Value="{StaticResource VinylAmber}" />
                <Setter TargetName="Light" Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="{StaticResource VinylAmberColor}" BlurRadius="6" ShadowDepth="0" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Key" Property="Background" Value="{StaticResource VinylAluminiumHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Key" Property="Margin" Value="0,2,0,0" />
                <Setter TargetName="Key" Property="Background" Value="{StaticResource VinylAluminiumPressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Groove with an amber fill and a ringed amber knob. -->
    <ControlTemplate x:Key="FlyoutSliderTemplate" TargetType="Slider">
        <Grid Height="20" Background="Transparent">
            <Border Height="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center"
                    Background="{DynamicResource FlyoutTrackBrush}" />
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource SliderFilledPart}" Command="Slider.DecreaseLarge" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource SliderEmptyPart}" Command="Slider.IncreaseLarge" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Focusable="False">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Ellipse Width="14" Height="14" Stroke="{StaticResource VinylInk}" StrokeThickness="2"
                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}" />
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Track.Thumb>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
