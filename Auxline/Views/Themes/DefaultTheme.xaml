<!--
    Default flyout theme: Windows 11 look. Control templates (icons from FluentIcons.xaml); the colours are added in code
    (FlyoutPalette) because they follow light/dark and the system accent. Every theme defines the same keys.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Auxline.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="FluentIcons.xaml" />
        <ResourceDictionary Source="SliderParts.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Around the whole layout: nothing, the window's acrylic or solid background shows. -->
    <ControlTemplate x:Key="FlyoutFrameTemplate" TargetType="ContentControl">
        <ContentPresenter />
    </ControlTemplate>

    <ControlTemplate x:Key="CoverArtTemplate" TargetType="controls:CoverArt">
        <Border CornerRadius="{TemplateBinding CornerRadius}">
            <Border.Background>
                <ImageBrush ImageSource="{Binding Source, RelativeSource={RelativeSource TemplatedParent}}" Stretch="UniformToFill" />
            </Border.Background>
        </Border>
    </ControlTemplate>

    <!-- Flat round button: transparent until hovered. -->
    <ControlTemplate x:Key="IconButtonTemplate" TargetType="ButtonBase">
        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="22">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource FlyoutHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource FlyoutPressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Filled circle. -->
    <ControlTemplate x:Key="PrimaryButtonTemplate" TargetType="Button">
        <Grid x:Name="Root">
            <Ellipse Fill="{TemplateBinding Background}" />
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Opacity" Value="0.88" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Opacity" Value="0.75" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Slim slider: rounded track with a filled part, round thumb. -->
    <ControlTemplate x:Key="FlyoutSliderTemplate" TargetType="Slider">
        <Grid Height="20" Background="Transparent">
            <Border Height="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" CornerRadius="2" VerticalAlignment="Center"
                    Background="{DynamicResource FlyoutTrackBrush}" />
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource SliderFilledPart}" Command="Slider.DecreaseLarge" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource SliderEmptyPart}" Command="Slider.IncreaseLarge" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Focusable="False">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Ellipse Width="14" Height="14"
                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}" />
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Track.Thumb>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Same, without a visible thumb: a thin bar (still clickable/draggable over a 12 px tall area). -->
    <ControlTemplate x:Key="FlyoutSliderThinTemplate" TargetType="Slider">
        <Grid Height="12" Background="Transparent">
            <Border Height="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" CornerRadius="2" VerticalAlignment="Center"
                    Background="{DynamicResource FlyoutTrackBrush}" />
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource SliderFilledPart}" Command="Slider.DecreaseLarge" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource SliderEmptyPart}" Command="Slider.IncreaseLarge" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Focusable="False" Template="{StaticResource InvisibleThumb}" />

                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>
</ResourceDictionary>
