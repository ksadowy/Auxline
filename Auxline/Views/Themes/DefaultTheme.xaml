<!--
    Default flyout theme: Windows 11 look. Control templates and icons; the colours are added in code
    (FlyoutPalette) because they follow light/dark and the system accent. Every theme defines the same keys.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Auxline.Controls">

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Around the whole layout: nothing, the window's acrylic or solid background shows. -->
    <ControlTemplate x:Key="FlyoutFrameTemplate" TargetType="ContentControl">
        <ContentPresenter />
    </ControlTemplate>

    <ControlTemplate x:Key="CoverArtTemplate" TargetType="controls:CoverArt">
        <Border CornerRadius="{TemplateBinding CornerRadius}">
            <Border.Background>
                <ImageBrush ImageSource="{Binding Source, RelativeSource={RelativeSource TemplatedParent}}" Stretch="UniformToFill" />
            </Border.Background>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="ThemedIconTemplate" TargetType="controls:ThemedIcon">
        <TextBlock x:Name="Glyph" FontFamily="{StaticResource IconFont}" Text="&#xE8D6;" />
        <ControlTemplate.Triggers>
            <Trigger Property="Kind" Value="Previous">
                <Setter TargetName="Glyph" Property="Text" Value="&#xE892;" />
            </Trigger>
            <Trigger Property="Kind" Value="Next">
                <Setter TargetName="Glyph" Property="Text" Value="&#xE893;" />
            </Trigger>
            <Trigger Property="Kind" Value="Play">
                <Setter TargetName="Glyph" Property="Text" Value="&#xE768;" />
            </Trigger>
            <Trigger Property="Kind" Value="Pause">
                <Setter TargetName="Glyph" Property="Text" Value="&#xE769;" />
            </Trigger>
            <Trigger Property="Kind" Value="Volume">
                <Setter TargetName="Glyph" Property="Text" Value="&#xE767;" />
            </Trigger>
            <Trigger Property="Kind" Value="VolumeLow">
                <Setter TargetName="Glyph" Property="Text" Value="&#xE992;" />
            </Trigger>
            <Trigger Property="Kind" Value="VolumeHigh">
                <Setter TargetName="Glyph" Property="Text" Value="&#xE995;" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Flat round button: transparent until hovered. -->
    <ControlTemplate x:Key="IconButtonTemplate" TargetType="ButtonBase">
        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="22">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource FlyoutHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource FlyoutPressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Filled circle. -->
    <ControlTemplate x:Key="PrimaryButtonTemplate" TargetType="Button">
        <Grid x:Name="Root">
            <Ellipse Fill="{TemplateBinding Background}" />
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Opacity" Value="0.88" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Opacity" Value="0.75" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="SliderFilledPart" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="{Binding Tag, RelativeSource={RelativeSource AncestorType=Slider}}"
                                CornerRadius="2" VerticalAlignment="Center"
                                Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderEmptyPart" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slim slider: rounded track with a filled part, round thumb. -->
    <ControlTemplate x:Key="FlyoutSliderTemplate" TargetType="Slider">
        <Grid Height="20" Background="Transparent">
            <Border Height="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" CornerRadius="2" VerticalAlignment="Center"
                    Background="{DynamicResource FlyoutTrackBrush}" />
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource SliderFilledPart}" Command="Slider.DecreaseLarge" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource SliderEmptyPart}" Command="Slider.IncreaseLarge" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Focusable="False">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Ellipse Width="14" Height="14"
                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}" />
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Track.Thumb>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Same, without a visible thumb: a thin bar (still clickable/draggable over a 12 px tall area). -->
    <ControlTemplate x:Key="FlyoutSliderThinTemplate" TargetType="Slider">
        <Grid Height="12" Background="Transparent">
            <Border Height="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" CornerRadius="2" VerticalAlignment="Center"
                    Background="{DynamicResource FlyoutTrackBrush}" />
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource SliderFilledPart}" Command="Slider.DecreaseLarge" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource SliderEmptyPart}" Command="Slider.IncreaseLarge" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Focusable="False">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Rectangle Width="10" Fill="Transparent" />
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>
</ResourceDictionary>
