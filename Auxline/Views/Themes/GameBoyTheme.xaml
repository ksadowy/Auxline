<!--
    Game Boy flyout theme: the four shades of a green handheld LCD, pixel font (FlyoutThemes), pixel icons, square
    buttons with a hard shadow, progress and volume as blocks. Animations: the progress block being filled blinks
    while playing; a new track fades in through the shades.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Auxline.Controls">

    <Color x:Key="GbDarkestColor">#0F380F</Color>
    <Color x:Key="GbDarkColor">#306230</Color>
    <Color x:Key="GbLightColor">#8BAC0F</Color>
    <Color x:Key="GbLightestColor">#9BBC0F</Color>

    <SolidColorBrush x:Key="GbDarkest" Color="{StaticResource GbDarkestColor}" />
    <SolidColorBrush x:Key="GbDark" Color="{StaticResource GbDarkColor}" />
    <SolidColorBrush x:Key="GbLight" Color="{StaticResource GbLightColor}" />
    <SolidColorBrush x:Key="GbLightest" Color="{StaticResource GbLightestColor}" />

    <!-- The keys every theme defines (see FlyoutPalette for what they're used for). -->
    <SolidColorBrush x:Key="FlyoutForegroundBrush" Color="{StaticResource GbDarkestColor}" />
    <SolidColorBrush x:Key="FlyoutBackgroundBrush" Color="{StaticResource GbLightestColor}" />
    <SolidColorBrush x:Key="FlyoutSecondaryTextBrush" Color="{StaticResource GbDarkColor}" />
    <SolidColorBrush x:Key="FlyoutTertiaryTextBrush" Color="{StaticResource GbDarkColor}" />
    <SolidColorBrush x:Key="FlyoutTrackBrush" Color="{StaticResource GbLightColor}" />
    <SolidColorBrush x:Key="FlyoutSliderFillBrush" Color="{StaticResource GbDarkestColor}" />
    <SolidColorBrush x:Key="FlyoutHoverBrush" Color="{StaticResource GbLightestColor}" />
    <SolidColorBrush x:Key="FlyoutPressedBrush" Color="{StaticResource GbLightColor}" />
    <SolidColorBrush x:Key="FlyoutSeparatorBrush" Color="{StaticResource GbDarkColor}" />
    <SolidColorBrush x:Key="FlyoutPrimaryButtonBrush" Color="{StaticResource GbDarkestColor}" />
    <SolidColorBrush x:Key="FlyoutPrimaryButtonForegroundBrush" Color="{StaticResource GbLightestColor}" />
    <SolidColorBrush x:Key="FlyoutAccentBrush" Color="{StaticResource GbDarkestColor}" />
    <SolidColorBrush x:Key="FlyoutAccentForegroundBrush" Color="{StaticResource GbLightestColor}" />

    <!-- The cover-tinted style stays on the LCD palette instead of the album art's colours. -->
    <SolidColorBrush x:Key="CoverTintBrush" Color="{StaticResource GbLightestColor}" />
    <SolidColorBrush x:Key="CoverAccentBrush" Color="{StaticResource GbDarkestColor}" />
    <SolidColorBrush x:Key="CoverAccentForegroundBrush" Color="{StaticResource GbLightestColor}" />
    <SolidColorBrush x:Key="CoverTextBrush" Color="{StaticResource GbDarkestColor}" />
    <SolidColorBrush x:Key="CoverSecondaryTextBrush" Color="{StaticResource GbDarkColor}" />

    <!-- Icons on an 8×8 pixel grid. -->
    <Geometry x:Key="PixelPrevious">M1,1h1v6h-1z M4,3h1v2h-1z M5,2h1v4h-1z M6,1h1v6h-1z</Geometry>
    <Geometry x:Key="PixelNext">M1,1h1v6h-1z M2,2h1v4h-1z M3,3h1v2h-1z M6,1h1v6h-1z</Geometry>
    <Geometry x:Key="PixelPlay">M2,0h1v8h-1z M3,1h1v6h-1z M4,2h1v4h-1z M5,3h1v2h-1z</Geometry>
    <Geometry x:Key="PixelPause">M1,1h2v6h-2z M5,1h2v6h-2z</Geometry>
    <Geometry x:Key="PixelVolumeLow">M0,3h2v2h-2z M2,2h1v4h-1z M3,1h1v6h-1z M5,3h1v2h-1z</Geometry>
    <Geometry x:Key="PixelVolume">M0,3h2v2h-2z M2,2h1v4h-1z M3,1h1v6h-1z M5,3h1v2h-1z M7,2h1v4h-1z</Geometry>
    <Geometry x:Key="PixelVolumeHigh">M0,3h2v2h-2z M2,2h1v4h-1z M3,1h1v6h-1z M5,3h1v2h-1z M7,1h1v6h-1z</Geometry>
    <Geometry x:Key="PixelMusic">M1,5h3v2h-3z M4,1h1v6h-1z M5,1h2v1h-2z M7,2h1v2h-1z</Geometry>

    <!-- Green LCD with a dark outline; a new track fades in from blank through the shades. -->
    <ControlTemplate x:Key="FlyoutFrameTemplate" TargetType="ContentControl">
        <Grid TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Aliased">
            <Border Background="{StaticResource GbLightest}" BorderBrush="{StaticResource GbDarkest}" BorderThickness="3">
                <ContentPresenter />
            </Border>
            <Border x:Name="Fade" Background="{StaticResource GbLightest}" Opacity="0" IsHitTestVisible="False" />
        </Grid>
        <ControlTemplate.Triggers>
            <EventTrigger RoutedEvent="controls:ThemeAnimation.TrackChanged">
                <BeginStoryboard>
                    <Storyboard FillBehavior="Stop">
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Fade" Storyboard.TargetProperty="Opacity">
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.15" Value="0.66" />
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.3" Value="0.33" />
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.45" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="CoverArtTemplate" TargetType="controls:CoverArt">
        <Border BorderBrush="{StaticResource GbDarkest}" BorderThickness="3" Background="{StaticResource GbDark}">
            <Border>
                <Border.Background>
                    <ImageBrush ImageSource="{Binding Source, RelativeSource={RelativeSource TemplatedParent}}" Stretch="UniformToFill" />
                </Border.Background>
            </Border>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="ThemedIconTemplate" TargetType="controls:ThemedIcon">
        <Viewbox Width="{TemplateBinding FontSize}" Height="{TemplateBinding FontSize}">
            <Canvas Width="8" Height="8">
                <Path x:Name="Shape" Fill="{TemplateBinding Foreground}" Data="{StaticResource PixelMusic}"
                      RenderOptions.EdgeMode="Aliased" />
            </Canvas>
        </Viewbox>
        <ControlTemplate.Triggers>
            <Trigger Property="Kind" Value="Previous">
                <Setter TargetName="Shape" Property="Data" Value="{StaticResource PixelPrevious}" />
            </Trigger>
            <Trigger Property="Kind" Value="Next">
                <Setter TargetName="Shape" Property="Data" Value="{StaticResource PixelNext}" />
            </Trigger>
            <Trigger Property="Kind" Value="Play">
                <Setter TargetName="Shape" Property="Data" Value="{StaticResource PixelPlay}" />
            </Trigger>
            <Trigger Property="Kind" Value="Pause">
                <Setter TargetName="Shape" Property="Data" Value="{StaticResource PixelPause}" />
            </Trigger>
            <Trigger Property="Kind" Value="Volume">
                <Setter TargetName="Shape" Property="Data" Value="{StaticResource PixelVolume}" />
            </Trigger>
            <Trigger Property="Kind" Value="VolumeLow">
                <Setter TargetName="Shape" Property="Data" Value="{StaticResource PixelVolumeLow}" />
            </Trigger>
            <Trigger Property="Kind" Value="VolumeHigh">
                <Setter TargetName="Shape" Property="Data" Value="{StaticResource PixelVolumeHigh}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Square key with a hard shadow; pressing (or checking a toggle) pushes it onto the shadow. -->
    <ControlTemplate x:Key="IconButtonTemplate" TargetType="ButtonBase">
        <Grid>
            <Border Margin="3,3,0,0" Background="{StaticResource GbDarkest}" />
            <Border x:Name="Face" Margin="0,0,3,3" Background="{StaticResource GbLight}"
                    BorderBrush="{StaticResource GbDarkest}" BorderThickness="2">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="Background" Value="{StaticResource GbLightest}" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
                <Setter TargetName="Face" Property="Margin" Value="3,3,0,0" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Face" Property="Margin" Value="3,3,0,0" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="PrimaryButtonTemplate" TargetType="Button">
        <Grid>
            <Border Margin="3,3,0,0" Background="{StaticResource GbDarkest}" />
            <Border x:Name="Face" Margin="0,0,3,3" Background="{TemplateBinding Background}"
                    BorderBrush="{StaticResource GbDarkest}" BorderThickness="2">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="Background" Value="{StaticResource GbDark}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Face" Property="Margin" Value="3,3,0,0" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- The blocks are drawn by SegmentBar; the Track on top only handles clicks and drags. -->
    <Style x:Key="InvisibleTrackPart" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="InvisibleThumb" TargetType="Thumb">
        <Rectangle Width="10" Fill="Transparent" />
    </ControlTemplate>

    <!-- Progress: the block being filled blinks while playing. Volume bars have no such block. -->
    <ControlTemplate x:Key="FlyoutSliderTemplate" TargetType="Slider">
        <Grid Height="20" Background="Transparent">
            <controls:SegmentBar x:Name="Bar" Height="10" VerticalAlignment="Center"
                                 Value="{TemplateBinding Value}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                 FilledBrush="{TemplateBinding Foreground}" EmptyBrush="{StaticResource GbLight}" />
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource InvisibleTrackPart}" Command="Slider.DecreaseLarge" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource InvisibleTrackPart}" Command="Slider.IncreaseLarge" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Focusable="False" Template="{StaticResource InvisibleThumb}" />
                </Track.Thumb>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Name" Value="ProgressSlider">
                <Setter TargetName="Bar" Property="ActiveBrush" Value="{StaticResource GbDark}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Name" Value="ProgressSlider" />
                    <Condition Property="controls:ThemeAnimation.IsActive" Value="True" />
                </MultiTrigger.Conditions>
                <MultiTrigger.EnterActions>
                    <BeginStoryboard x:Name="Blink">
                        <Storyboard Timeline.DesiredFrameRate="10">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Bar" Storyboard.TargetProperty="ActiveOpacity"
                                                           Duration="0:0:1" RepeatBehavior="Forever">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.EnterActions>
                <MultiTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="Blink" />
                </MultiTrigger.ExitActions>
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="FlyoutSliderThinTemplate" TargetType="Slider">
        <Grid Height="12" Background="Transparent">
            <controls:SegmentBar x:Name="Bar" Height="6" VerticalAlignment="Center" SegmentLength="10"
                                 Value="{TemplateBinding Value}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                 FilledBrush="{TemplateBinding Foreground}" EmptyBrush="{StaticResource GbLight}" />
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource InvisibleTrackPart}" Command="Slider.DecreaseLarge" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource InvisibleTrackPart}" Command="Slider.IncreaseLarge" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Focusable="False" Template="{StaticResource InvisibleThumb}" />
                </Track.Thumb>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Name" Value="ProgressSlider">
                <Setter TargetName="Bar" Property="ActiveBrush" Value="{StaticResource GbDark}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Name" Value="ProgressSlider" />
                    <Condition Property="controls:ThemeAnimation.IsActive" Value="True" />
                </MultiTrigger.Conditions>
                <MultiTrigger.EnterActions>
                    <BeginStoryboard x:Name="Blink">
                        <Storyboard Timeline.DesiredFrameRate="10">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Bar" Storyboard.TargetProperty="ActiveOpacity"
                                                           Duration="0:0:1" RepeatBehavior="Forever">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.EnterActions>
                <MultiTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="Blink" />
                </MultiTrigger.ExitActions>
            </MultiTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
