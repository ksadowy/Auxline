<!--
    Arcade flyout theme: black CRT with scanlines and a neon outline, Press Start 2P font (FlyoutThemes), pixel icons,
    round arcade buttons, progress as pellets being eaten, volume as rising bars. A "1UP · NOW PLAYING" header.
    Animations while playing: 1UP blinks, header equaliser bounces, a bright band rolls down the screen, the
    progress marker pulses and the pellets ahead twinkle. A new track flashes the screen and shows "READY!".
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Auxline.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="PixelIcons.xaml" />
        <ResourceDictionary Source="SliderParts.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Color x:Key="ArcadeScreenColor">#05030F</Color>
    <Color x:Key="ArcadeNeonColor">#4FF0FF</Color>
    <Color x:Key="ArcadeTextColor">#F4ECFF</Color>
    <Color x:Key="ArcadeLilacColor">#C9B8FF</Color>
    <Color x:Key="ArcadeDimColor">#2A1F52</Color>
    <Color x:Key="ArcadeYellowColor">#FFE14F</Color>
    <Color x:Key="ArcadeRedColor">#FF2E4D</Color>

    <SolidColorBrush x:Key="ArcadeNeon" Color="{StaticResource ArcadeNeonColor}" />
    <SolidColorBrush x:Key="ArcadeYellow" Color="{StaticResource ArcadeYellowColor}" />
    <SolidColorBrush x:Key="ArcadeRed" Color="{StaticResource ArcadeRedColor}" />
    <SolidColorBrush x:Key="ArcadeDim" Color="{StaticResource ArcadeDimColor}" />
    <SolidColorBrush x:Key="ArcadeEaten" Color="#3B2A7A" />

    <!-- The keys every theme defines (see FlyoutPalette for what they're used for). -->
    <SolidColorBrush x:Key="FlyoutForegroundBrush" Color="{StaticResource ArcadeTextColor}" />
    <SolidColorBrush x:Key="FlyoutBackgroundBrush" Color="{StaticResource ArcadeScreenColor}" />
    <SolidColorBrush x:Key="FlyoutSecondaryTextBrush" Color="{StaticResource ArcadeLilacColor}" />
    <SolidColorBrush x:Key="FlyoutTertiaryTextBrush" Color="#8F7FC0" />
    <SolidColorBrush x:Key="FlyoutTrackBrush" Color="{StaticResource ArcadeDimColor}" />
    <SolidColorBrush x:Key="FlyoutSliderFillBrush" Color="{StaticResource ArcadeNeonColor}" />
    <SolidColorBrush x:Key="FlyoutHoverBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="FlyoutPressedBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="FlyoutSeparatorBrush" Color="{StaticResource ArcadeDimColor}" />
    <SolidColorBrush x:Key="FlyoutPrimaryButtonBrush" Color="{StaticResource ArcadeRedColor}" />
    <SolidColorBrush x:Key="FlyoutPrimaryButtonForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="FlyoutAccentBrush" Color="{StaticResource ArcadeNeonColor}" />
    <SolidColorBrush x:Key="FlyoutAccentForegroundBrush" Color="{StaticResource ArcadeScreenColor}" />
    <SolidColorBrush x:Key="CoverTintBrush" Color="#120A2E" />
    <SolidColorBrush x:Key="CoverAccentBrush" Color="{StaticResource ArcadeNeonColor}" />
    <SolidColorBrush x:Key="CoverAccentForegroundBrush" Color="{StaticResource ArcadeScreenColor}" />
    <SolidColorBrush x:Key="CoverTextBrush" Color="{StaticResource ArcadeTextColor}" />
    <SolidColorBrush x:Key="CoverSecondaryTextBrush" Color="{StaticResource ArcadeLilacColor}" />

    <!-- Icons on the arcade buttons (see ThemedIcon.IconBrush). -->
    <SolidColorBrush x:Key="IconButtonIconBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PrimaryButtonIconBrush" Color="#FFFFFF" />

    <!-- Faint horizontal lines every 3 px. -->
    <LinearGradientBrush x:Key="ArcadeScanlines" StartPoint="0,0" EndPoint="0,3" MappingMode="Absolute" SpreadMethod="Repeat">
        <GradientStop Color="#0DFFFFFF" Offset="0" />
        <GradientStop Color="#0DFFFFFF" Offset="0.33" />
        <GradientStop Color="Transparent" Offset="0.33" />
        <GradientStop Color="Transparent" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="ArcadeEqualizerBar" TargetType="Rectangle">
        <Setter Property="Width" Value="3" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Fill" Value="{StaticResource ArcadeNeon}" />
        <Setter Property="RenderTransformOrigin" Value="0.5,1" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleY="0.5" />
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="FlyoutFrameTemplate" TargetType="ContentControl">
        <Grid ClipToBounds="True" Background="{StaticResource FlyoutBackgroundBrush}"
              TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Aliased">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Margin="16,14,16,0" TextElement.FontSize="8">
                <TextBlock x:Name="OneUp" DockPanel.Dock="Left" Text="1UP" Foreground="{StaticResource ArcadeRed}" />
                <TextBlock x:Name="Status" DockPanel.Dock="Right" Text="NOW PLAYING" Foreground="{StaticResource ArcadeYellow}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <Rectangle x:Name="Eq1" Style="{StaticResource ArcadeEqualizerBar}" />
                    <Rectangle x:Name="Eq2" Style="{StaticResource ArcadeEqualizerBar}" />
                    <Rectangle x:Name="Eq3" Style="{StaticResource ArcadeEqualizerBar}" />
                    <Rectangle x:Name="Eq4" Style="{StaticResource ArcadeEqualizerBar}" />
                    <Rectangle x:Name="Eq5" Style="{StaticResource ArcadeEqualizerBar}" />
                </StackPanel>
            </DockPanel>
            <ContentPresenter Grid.Row="1" />

            <Rectangle Grid.RowSpan="2" IsHitTestVisible="False" Fill="{StaticResource ArcadeScanlines}" />
            <Rectangle x:Name="Band" Grid.RowSpan="2" Height="60" VerticalAlignment="Top" IsHitTestVisible="False" Opacity="0">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="Transparent" Offset="0" />
                        <GradientStop Color="#124FF0FF" Offset="0.5" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
                <Rectangle.RenderTransform>
                    <TranslateTransform Y="-60" />
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="Dim" Grid.RowSpan="2" IsHitTestVisible="False" Fill="Black" Opacity="0" />
            <Rectangle x:Name="Flash" Grid.RowSpan="2" IsHitTestVisible="False" Fill="White" Opacity="0" />
            <Border x:Name="Banner" Grid.RowSpan="2" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0"
                    Background="#EB05030F" BorderBrush="{StaticResource ArcadeYellow}" BorderThickness="0,2" Padding="0,10">
                <TextBlock Text="READY!" FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource ArcadeYellow}" />
            </Border>
            <!-- Neon outline with a glow, on top so the glow isn't covered. -->
            <Border Grid.RowSpan="2" IsHitTestVisible="False" BorderBrush="{StaticResource ArcadeNeon}" BorderThickness="2">
                <Border.Effect>
                    <DropShadowEffect Color="{StaticResource ArcadeNeonColor}" BlurRadius="12" ShadowDepth="0" Opacity="0.8" />
                </Border.Effect>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsPlaying}" Value="False">
                <Setter TargetName="Status" Property="Text" Value="PAUSED" />
                <Setter TargetName="Dim" Property="Opacity" Value="0.35" />
            </DataTrigger>
            <Trigger Property="controls:ThemeAnimation.IsActive" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="Attract">
                        <Storyboard Timeline.DesiredFrameRate="30">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="OneUp" Storyboard.TargetProperty="Opacity"
                                                           Duration="0:0:1" RepeatBehavior="Forever">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="Eq1" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             From="0.2" To="1" Duration="0:0:0.45" AutoReverse="True" RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="Eq2" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             From="0.2" To="1" Duration="0:0:0.7" AutoReverse="True" RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="Eq3" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             From="0.2" To="1" Duration="0:0:0.55" AutoReverse="True" RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="Eq4" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             From="0.2" To="1" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="Eq5" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             From="0.2" To="1" Duration="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="Band" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="Band" Storyboard.TargetProperty="RenderTransform.Y"
                                             From="-60" To="700" Duration="0:0:6" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="Attract" />
                </Trigger.ExitActions>
            </Trigger>
            <EventTrigger RoutedEvent="controls:ThemeAnimation.TrackChanged">
                <BeginStoryboard>
                    <Storyboard FillBehavior="Stop">
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Flash" Storyboard.TargetProperty="Opacity">
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.5" />
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.07" Value="0" />
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.14" Value="0.25" />
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.21" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Banner" Storyboard.TargetProperty="Opacity">
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                            <DiscreteDoubleKeyFrame KeyTime="0:0:1.1" Value="0.66" />
                            <DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="0.33" />
                            <DiscreteDoubleKeyFrame KeyTime="0:0:1.3" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="CoverArtTemplate" TargetType="controls:CoverArt">
        <Border BorderBrush="{StaticResource ArcadeNeon}" BorderThickness="2">
            <Border.Background>
                <ImageBrush ImageSource="{Binding Source, RelativeSource={RelativeSource TemplatedParent}}" Stretch="UniformToFill" />
            </Border.Background>
        </Border>
    </ControlTemplate>

    <!-- Round arcade button on a dark base; pressing pushes it down. Blue for icon buttons, red for play. -->
    <ControlTemplate x:Key="IconButtonTemplate" TargetType="ButtonBase">
        <Grid>
            <Ellipse Margin="0,3,0,0" Fill="#0C2466" />
            <Grid x:Name="Face" Margin="0,0,0,3">
                <Ellipse x:Name="Cap" Fill="#2B6CFF" Stroke="#173C99" StrokeThickness="4" />
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Cap" Property="Fill" Value="#4A84FF" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
                <Setter TargetName="Face" Property="Margin" Value="0,3,0,0" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Face" Property="Margin" Value="0,3,0,0" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="PrimaryButtonTemplate" TargetType="Button">
        <Grid>
            <Ellipse Margin="0,3,0,0" Fill="#5C0B18" />
            <Grid x:Name="Face" Margin="0,0,0,3">
                <Ellipse x:Name="Cap" Fill="{StaticResource ArcadeRed}" Stroke="#8F1226" StrokeThickness="5" />
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Cap" Property="Fill" Value="#FF5068" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Face" Property="Margin" Value="0,3,0,0" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <RadialGradientBrush x:Key="ArcadeMarkerGlow">
        <GradientStop Color="#99FFE14F" Offset="0" />
        <GradientStop Color="#00FFE14F" Offset="1" />
    </RadialGradientBrush>

    <!-- Progress: pellets (pulse and twinkle while playing). Volume: rising bars. -->
    <ControlTemplate x:Key="FlyoutSliderTemplate" TargetType="Slider">
        <Grid Height="20" Background="Transparent">
            <controls:SegmentBar x:Name="Bars" Height="16" VerticalAlignment="Center" IsRising="True" SegmentLength="8" Gap="3"
                                 Value="{TemplateBinding Value}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                 FilledBrush="{TemplateBinding Foreground}" EmptyBrush="{StaticResource ArcadeDim}" />
            <controls:PelletBar x:Name="Pellets" Height="14" VerticalAlignment="Center" Visibility="Collapsed"
                                Value="{TemplateBinding Value}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                EatenBrush="{StaticResource ArcadeEaten}" PelletBrush="{TemplateBinding Foreground}"
                                MarkerBrush="{StaticResource ArcadeYellow}" GlowBrush="{StaticResource ArcadeMarkerGlow}" />
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource SliderEmptyPart}" Command="Slider.DecreaseLarge" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource SliderEmptyPart}" Command="Slider.IncreaseLarge" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Focusable="False" Template="{StaticResource InvisibleThumb}" />
                </Track.Thumb>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Name" Value="ProgressSlider">
                <Setter TargetName="Bars" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Pellets" Property="Visibility" Value="Visible" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Name" Value="ProgressSlider" />
                    <Condition Property="controls:ThemeAnimation.IsActive" Value="True" />
                </MultiTrigger.Conditions>
                <MultiTrigger.EnterActions>
                    <BeginStoryboard x:Name="Twinkle">
                        <Storyboard Timeline.DesiredFrameRate="24">
                            <DoubleAnimation Storyboard.TargetName="Pellets" Storyboard.TargetProperty="Phase"
                                             From="0.001" To="1" Duration="0:0:1.6" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.EnterActions>
                <MultiTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="Twinkle" />
                </MultiTrigger.ExitActions>
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="FlyoutSliderThinTemplate" TargetType="Slider">
        <Grid Height="12" Background="Transparent">
            <controls:SegmentBar x:Name="Bars" Height="10" VerticalAlignment="Center" IsRising="True" SegmentLength="6" Gap="2"
                                 Value="{TemplateBinding Value}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                 FilledBrush="{TemplateBinding Foreground}" EmptyBrush="{StaticResource ArcadeDim}" />
            <controls:PelletBar x:Name="Pellets" Height="8" VerticalAlignment="Center" Spacing="12" Visibility="Collapsed"
                                Value="{TemplateBinding Value}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                EatenBrush="{StaticResource ArcadeEaten}" PelletBrush="{TemplateBinding Foreground}"
                                MarkerBrush="{StaticResource ArcadeYellow}" GlowBrush="{StaticResource ArcadeMarkerGlow}" />
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource SliderEmptyPart}" Command="Slider.DecreaseLarge" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource SliderEmptyPart}" Command="Slider.IncreaseLarge" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Focusable="False" Template="{StaticResource InvisibleThumb}" />
                </Track.Thumb>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Name" Value="ProgressSlider">
                <Setter TargetName="Bars" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Pellets" Property="Visibility" Value="Visible" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Name" Value="ProgressSlider" />
                    <Condition Property="controls:ThemeAnimation.IsActive" Value="True" />
                </MultiTrigger.Conditions>
                <MultiTrigger.EnterActions>
                    <BeginStoryboard x:Name="Twinkle">
                        <Storyboard Timeline.DesiredFrameRate="24">
                            <DoubleAnimation Storyboard.TargetName="Pellets" Storyboard.TargetProperty="Phase"
                                             From="0.001" To="1" Duration="0:0:1.6" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.EnterActions>
                <MultiTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="Twinkle" />
                </MultiTrigger.ExitActions>
            </MultiTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
