<!--
    Terminal flyout theme: green phosphor on black, monospace (FlyoutThemes), a title bar with the source and a
    blinking cursor, text icons ("|<", "||"), boxed buttons that invert on hover, block bars in brackets, and the
    cover in phosphor green with scanlines. While playing the cursor and the progress block being filled blink;
    a new track makes the screen flicker.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Auxline.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="SliderParts.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Color x:Key="PhosphorColor">#33FF66</Color>
    <Color x:Key="ConsoleColor">#0C0C0C</Color>

    <SolidColorBrush x:Key="Phosphor" Color="{StaticResource PhosphorColor}" />
    <SolidColorBrush x:Key="PhosphorDim" Color="#8C33FF66" />
    <SolidColorBrush x:Key="PhosphorFaint" Color="#4033FF66" />
    <SolidColorBrush x:Key="Console" Color="{StaticResource ConsoleColor}" />

    <!-- The keys every theme defines (see FlyoutPalette for what they're used for). -->
    <SolidColorBrush x:Key="FlyoutForegroundBrush" Color="{StaticResource PhosphorColor}" />
    <SolidColorBrush x:Key="FlyoutBackgroundBrush" Color="{StaticResource ConsoleColor}" />
    <SolidColorBrush x:Key="FlyoutSecondaryTextBrush" Color="#B333FF66" />
    <SolidColorBrush x:Key="FlyoutTertiaryTextBrush" Color="#8033FF66" />
    <SolidColorBrush x:Key="FlyoutTrackBrush" Color="#4033FF66" />
    <SolidColorBrush x:Key="FlyoutSliderFillBrush" Color="{StaticResource PhosphorColor}" />
    <SolidColorBrush x:Key="FlyoutHoverBrush" Color="#2633FF66" />
    <SolidColorBrush x:Key="FlyoutPressedBrush" Color="#4033FF66" />
    <SolidColorBrush x:Key="FlyoutSeparatorBrush" Color="#4033FF66" />
    <SolidColorBrush x:Key="FlyoutPrimaryButtonBrush" Color="{StaticResource PhosphorColor}" />
    <SolidColorBrush x:Key="FlyoutPrimaryButtonForegroundBrush" Color="{StaticResource ConsoleColor}" />
    <SolidColorBrush x:Key="FlyoutAccentBrush" Color="{StaticResource PhosphorColor}" />
    <SolidColorBrush x:Key="FlyoutAccentForegroundBrush" Color="{StaticResource ConsoleColor}" />
    <SolidColorBrush x:Key="CoverTintBrush" Color="{StaticResource ConsoleColor}" />
    <SolidColorBrush x:Key="CoverAccentBrush" Color="{StaticResource PhosphorColor}" />
    <SolidColorBrush x:Key="CoverAccentForegroundBrush" Color="{StaticResource ConsoleColor}" />
    <SolidColorBrush x:Key="CoverTextBrush" Color="{StaticResource PhosphorColor}" />
    <SolidColorBrush x:Key="CoverSecondaryTextBrush" Color="#B333FF66" />

    <!-- Dark text on the filled play button (see ThemedIcon.IconBrush). -->
    <SolidColorBrush x:Key="PrimaryButtonIconBrush" Color="{StaticResource ConsoleColor}" />

    <controls:LuminanceMaskConverter x:Key="LuminanceMask" />

    <!-- Dark lines every 3 px over the cover. -->
    <LinearGradientBrush x:Key="TerminalScanlines" StartPoint="0,0" EndPoint="0,3" MappingMode="Absolute" SpreadMethod="Repeat">
        <GradientStop Color="#73000000" Offset="0" />
        <GradientStop Color="#73000000" Offset="0.33" />
        <GradientStop Color="Transparent" Offset="0.33" />
        <GradientStop Color="Transparent" Offset="1" />
    </LinearGradientBrush>

    <ControlTemplate x:Key="FlyoutFrameTemplate" TargetType="ContentControl">
        <Grid Background="{StaticResource Console}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="{StaticResource PhosphorDim}" Padding="10,3">
                    <StackPanel Orientation="Horizontal" TextElement.Foreground="{StaticResource Console}" TextElement.FontSize="11">
                        <TextBlock Text="auxline — " />
                        <TextBlock Text="{Binding SourceName}" />
                        <Rectangle x:Name="Cursor" Width="7" Height="12" Margin="4,0,0,0" VerticalAlignment="Center"
                                   Fill="{StaticResource Console}" />
                    </StackPanel>
                </Border>
                <ContentPresenter />
            </DockPanel>
            <Rectangle x:Name="Flicker" IsHitTestVisible="False" Fill="{StaticResource Phosphor}" Opacity="0" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="controls:ThemeAnimation.IsActive" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="Blink">
                        <Storyboard Timeline.DesiredFrameRate="10">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Cursor" Storyboard.TargetProperty="Opacity"
                                                           Duration="0:0:1" RepeatBehavior="Forever">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="Blink" />
                </Trigger.ExitActions>
            </Trigger>
            <EventTrigger RoutedEvent="controls:ThemeAnimation.TrackChanged">
                <BeginStoryboard>
                    <Storyboard FillBehavior="Stop">
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Flicker" Storyboard.TargetProperty="Opacity">
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.15" />
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.06" Value="0" />
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.12" Value="0.1" />
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.18" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- The cover drawn in phosphor green through its brightness, with scanlines. -->
    <ControlTemplate x:Key="CoverArtTemplate" TargetType="controls:CoverArt">
        <Border BorderBrush="{StaticResource PhosphorDim}" BorderThickness="1">
            <Grid>
                <Rectangle Fill="{StaticResource Phosphor}">
                    <Rectangle.OpacityMask>
                        <ImageBrush Stretch="UniformToFill"
                                    ImageSource="{Binding Source, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource LuminanceMask}}" />
                    </Rectangle.OpacityMask>
                </Rectangle>
                <Rectangle Fill="{StaticResource TerminalScanlines}" />
            </Grid>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="ThemedIconTemplate" TargetType="controls:ThemedIcon">
        <TextBlock x:Name="Text" Text="♪" Foreground="{TemplateBinding DisplayBrush}" />
        <ControlTemplate.Triggers>
            <Trigger Property="Kind" Value="Previous">
                <Setter TargetName="Text" Property="Text" Value="|&lt;" />
            </Trigger>
            <Trigger Property="Kind" Value="Next">
                <Setter TargetName="Text" Property="Text" Value="&gt;|" />
            </Trigger>
            <Trigger Property="Kind" Value="Play">
                <Setter TargetName="Text" Property="Text" Value="&gt;" />
            </Trigger>
            <Trigger Property="Kind" Value="Pause">
                <Setter TargetName="Text" Property="Text" Value="||" />
            </Trigger>
            <Trigger Property="Kind" Value="Volume">
                <Setter TargetName="Text" Property="Text" Value="vol" />
            </Trigger>
            <Trigger Property="Kind" Value="VolumeLow">
                <Setter TargetName="Text" Property="Text" Value="-" />
            </Trigger>
            <Trigger Property="Kind" Value="VolumeHigh">
                <Setter TargetName="Text" Property="Text" Value="+" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- A box around the text; hovering inverts it, like a selected item. -->
    <ControlTemplate x:Key="IconButtonTemplate" TargetType="ButtonBase">
        <Border x:Name="Box" Margin="2" BorderThickness="1" BorderBrush="{StaticResource PhosphorDim}" Background="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource PhosphorFaint}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource Phosphor}" />
                <Setter Property="controls:ThemedIcon.IconBrush" Value="{StaticResource Console}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource PhosphorDim}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="PrimaryButtonTemplate" TargetType="Button">
        <Border x:Name="Box" Margin="2" Background="{StaticResource Phosphor}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="Background" Value="#7DFF9C" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource PhosphorDim}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- [█████░░░░░] with the progress block being filled blinking like a cursor. -->
    <ControlTemplate x:Key="FlyoutSliderTemplate" TargetType="Slider">
        <Grid Height="20" Background="Transparent">
            <DockPanel VerticalAlignment="Center">
                <TextBlock DockPanel.Dock="Left" Margin="0,0,3,0" Text="[" VerticalAlignment="Center" Foreground="{StaticResource PhosphorDim}" />
                <TextBlock DockPanel.Dock="Right" Margin="3,0,0,0" Text="]" VerticalAlignment="Center" Foreground="{StaticResource PhosphorDim}" />
                <controls:SegmentBar x:Name="Bar" Height="10" SegmentLength="6" Gap="2"
                                     Value="{TemplateBinding Value}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                     FilledBrush="{TemplateBinding Foreground}" EmptyBrush="{StaticResource PhosphorFaint}" />
            </DockPanel>
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource SliderEmptyPart}" Command="Slider.DecreaseLarge" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource SliderEmptyPart}" Command="Slider.IncreaseLarge" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Focusable="False" Template="{StaticResource InvisibleThumb}" />
                </Track.Thumb>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Name" Value="ProgressSlider">
                <Setter TargetName="Bar" Property="ActiveBrush" Value="{StaticResource PhosphorDim}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Name" Value="ProgressSlider" />
                    <Condition Property="controls:ThemeAnimation.IsActive" Value="True" />
                </MultiTrigger.Conditions>
                <MultiTrigger.EnterActions>
                    <BeginStoryboard x:Name="Blink">
                        <Storyboard Timeline.DesiredFrameRate="10">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Bar" Storyboard.TargetProperty="ActiveOpacity"
                                                           Duration="0:0:1" RepeatBehavior="Forever">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.EnterActions>
                <MultiTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="Blink" />
                </MultiTrigger.ExitActions>
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="FlyoutSliderThinTemplate" TargetType="Slider">
        <Grid Height="12" Background="Transparent">
            <controls:SegmentBar x:Name="Bar" Height="6" VerticalAlignment="Center" SegmentLength="5" Gap="2"
                                 Value="{TemplateBinding Value}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                 FilledBrush="{TemplateBinding Foreground}" EmptyBrush="{StaticResource PhosphorFaint}" />
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource SliderEmptyPart}" Command="Slider.DecreaseLarge" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource SliderEmptyPart}" Command="Slider.IncreaseLarge" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Focusable="False" Template="{StaticResource InvisibleThumb}" />
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>
</ResourceDictionary>
