<Window x:Class="Auxline.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Auxline.ViewModels"
        xmlns:controls="clr-namespace:Auxline.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:PlayerViewModel}"
        Title="Auxline"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Left="0" Top="0"
        SizeToContent="Width" MaxWidth="240" Height="48"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Cursor="Hand">
    <!-- Fully transparent pixels let clicks through to the taskbar; 1/255 alpha catches them. Only the content is
         clickable, so a widget with nothing playing or no room (shrunk to ~0 width) never blocks taskbar icons.
         Collapsing instead of hiding/re-showing avoids redoing positioning and the taskbar ownership. -->
    <Border x:Name="ContentBorder" Background="#01000000" Padding="6,0"
            Visibility="{Binding HasTrack, Converter={StaticResource BoolToVisibility}}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Border + ImageBrush instead of a clipped Image: the size is a setting, and a clip geometry would need resizing too. -->
            <Border x:Name="CoverImage" Width="32" Height="32" CornerRadius="4" VerticalAlignment="Center">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                </Border.Background>
            </Border>

            <StackPanel x:Name="TextPanel" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ArtistText" Text="{Binding Artist}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Music meter: look from the flyout theme (WidgetWindow.ApplyLook); stays (flat) while paused, so the width doesn't jump. -->
            <controls:LevelMeter x:Name="Meter" Grid.Column="2" Margin="8,0,2,0" Height="14" VerticalAlignment="Center"
                                 Level="{Binding AudioLevel}" />
        </Grid>
    </Border>
</Window>
