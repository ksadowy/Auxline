<Window x:Class="TaskbarPlayer.Views.DebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TaskbarPlayer.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:DebugViewModel}"
        Title="Taskbar Player - Debug"
        SizeToContent="WidthAndHeight"
        ResizeMode="CanMinimize">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <Border Width="160" Height="160" Background="#22000000" CornerRadius="6">
            <Image Source="{Binding Cover}" Stretch="UniformToFill" />
        </Border>

        <StackPanel Grid.Column="1" Margin="16,0,0,0">
            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Artist}" FontSize="14" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Album}" Foreground="Gray" TextTrimming="CharacterEllipsis" />
            <TextBlock Margin="0,8,0,0" Foreground="Gray">
                <Run Text="Source: " /><Run Text="{Binding Source, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Text="{Binding Playback}" Foreground="Gray" />

            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                <Button Content="Previous" Command="{Binding SkipPreviousCommand}" Padding="10,4" />
                <Button Content="Play / Pause" Command="{Binding TogglePlayPauseCommand}" Padding="10,4" Margin="8,0" />
                <Button Content="Next" Command="{Binding SkipNextCommand}" Padding="10,4" />
            </StackPanel>

            <TextBlock Text="{Binding Status}" Margin="0,8,0,0" Foreground="IndianRed" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
